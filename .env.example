# Copy to .env to override. Every value has a safe default; no .env is needed to run.

# Port the app (API + UI) listens on.
PORT=3000

# 127.0.0.1 = this computer only (default).
# 0.0.0.0 = reachable from a phone on the same Wi-Fi. There is NO login; use only on a trusted network.
HOST=127.0.0.1

# Where raw uploads and the database are stored. Default: server/data
# DATA_DIR=
